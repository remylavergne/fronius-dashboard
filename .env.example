# Configuration de froniusd — variables d'environnement uniquement en phase 1.
# Copier en `.env` (non versionné) ou exporter dans le shell. Aucune valeur secrète ici :
# la phase 1 n'utilise que la Solar API lecture seule, sans authentification.

# URL de base de la Solar API. Par défaut le simulateur local.
# Matériel réel (phase 2+) : http://192.0.2.10
FRONIUS_SOLARAPI_URL=http://127.0.0.1:8081

# Adresse d'écoute de l'API REST. Doit rester locale sans FRONIUS_ALLOW_REMOTE=1.
FRONIUS_HTTP_ADDR=127.0.0.1:8080

# Autorise une écoute non-loopback. L'API n'a AUCUNE authentification en phase 1 :
# ne passer à 1 qu'après avoir lu docs/adr/0005-authentification-et-acces-distant.md.
FRONIUS_ALLOW_REMOTE=0

# Chemin de la base SQLite (répertoire parent créé automatiquement).
FRONIUS_DB_PATH=./data/fronius.db

# Fuseau de l'installation : utilisé pour les dates locales (journées, DST).
FRONIUS_TZ=Europe/Brussels

# Intervalle de polling (le client officiel interroge toutes les 5 s).
FRONIUS_POLL_INTERVAL=5s
# Jitter appliqué à chaque cycle (± valeur) pour éviter la synchronisation.
FRONIUS_POLL_JITTER=500ms

# Timeout HTTP par requête vers la Solar API.
FRONIUS_HTTP_TIMEOUT=5s

# Rétention en jours. 0 = conservation illimitée. Valeur négative refusée.
FRONIUS_RETENTION_DAYS=0

# Journalisation : level ∈ {debug,info,warn,error}, format ∈ {text,json}.
FRONIUS_LOG_LEVEL=info
FRONIUS_LOG_FORMAT=text

# Dossier d'assets statiques du frontend (vide = frontend non servi par froniusd).
FRONIUS_WEB_DIR=

# Au-delà de cette durée sans mesure, /api/v1/live signale meta.stale = true.
FRONIUS_STALE_AFTER=30s

# Identifiants de l'appareil (chemins internes protégés par Digest).
# Lus par `froniusd` et `fronius-probe` uniquement : jamais par le frontend,
# jamais renvoyés par l'API REST. Les deux vont ensemble : n'en définir qu'un
# est une erreur de configuration. Ne jamais versionner de valeur non vide ici.
FRONIUS_DEVICE_USER=
FRONIUS_DEVICE_PASSWORD=

# Intervalle de détection (identité, compteur, batterie, événements).
# Le client officiel interroge ces chemins toutes les 5 s ; minimum 5s.
FRONIUS_DETECT_INTERVAL=60s
