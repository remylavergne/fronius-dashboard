# froniusd configuration — environment variables only in phase 1.
# Copy to `.env` (not versioned) or export in the shell. No secret value here:
# phase 1 uses only the read-only Solar API, without authentication.

# Base URL of the Solar API. Defaults to the local simulator.
# Real hardware (phase 2+): http://192.0.2.10
FRONIUS_SOLARAPI_URL=http://127.0.0.1:8081

# Listen address of the REST API. Must stay local without FRONIUS_ALLOW_REMOTE=1.
FRONIUS_HTTP_ADDR=127.0.0.1:8080

# Allows a non-loopback listen. The API has NO authentication in phase 1:
# only switch to 1 after reading docs/adr/0005-authentication-and-remote-access.md.
FRONIUS_ALLOW_REMOTE=0

# Path of the SQLite database (parent directory created automatically).
FRONIUS_DB_PATH=./data/fronius.db

# Installation timezone: used for local dates (days, DST).
FRONIUS_TZ=Europe/Brussels

# Polling interval (the official client polls every 5 s).
FRONIUS_POLL_INTERVAL=5s
# Jitter applied to each cycle (± value) to avoid synchronisation.
FRONIUS_POLL_JITTER=500ms

# HTTP timeout per request to the Solar API.
FRONIUS_HTTP_TIMEOUT=5s

# Retention in days. 0 = unlimited retention. Negative value refused.
FRONIUS_RETENTION_DAYS=0

# Logging: level ∈ {debug,info,warn,error}, format ∈ {text,json}.
FRONIUS_LOG_LEVEL=info
FRONIUS_LOG_FORMAT=text

# Frontend static assets directory (empty = frontend not served by froniusd).
FRONIUS_WEB_DIR=

# Beyond this duration without a measurement, /api/v1/live reports meta.stale = true.
FRONIUS_STALE_AFTER=30s

# Device credentials (internal paths protected by Digest).
# Read by `froniusd` and `fronius-probe` only: never by the frontend,
# never returned by the REST API. The two go together: defining only one
# is a configuration error. Never version a non-empty value here.
FRONIUS_DEVICE_USER=
FRONIUS_DEVICE_PASSWORD=

# Detection interval (identity, meter, battery, events).
# The official client polls these paths every 5 s; minimum 5s.
FRONIUS_DETECT_INTERVAL=60s
